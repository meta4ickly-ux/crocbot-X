# Caddyfile — Caddy is the only public entry point.
# CROCBOT_DOMAIN, CROCBOT_USER and CROCBOT_AUTH_HASH come from .env
# via the caddy service env_file in docker-compose.yml.
# http:// prefix = serve HTTP on an IP without TLS. A real domain
# without the http:// prefix gets automatic TLS from Caddy.
# Generate the hash on the VPS (never in chat):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# then put the $2a$... output in .env as CROCBOT_AUTH_HASH.

http://{$CROCBOT_DOMAIN} {
    basicauth * {
        {$CROCBOT_USER} {$CROCBOT_AUTH_HASH}
    }
    reverse_proxy api:8000
}
