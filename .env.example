# Crocbot X — copy to .env, never commit .env (chmod 600 on the server).
# Local dev: most of these can stay blank — the stub engine runs at $0.
CROCBOT_ENV=dev
CROCBOT_HOST=127.0.0.1
CROCBOT_PORT=8000
CROCBOT_LOG=crocbot-x.log

# Engine: muse (default, in-process), xai, codex, pi, stub
CROCBOT_ENGINE=muse
CROCBOT_ENGINE_TIMEOUT_S=300
CROCBOT_MAX_STEPS=10

# xAI — the model provider. Never commit a real key.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_CHEAP_MODEL=grok-4.3
XAI_CODE_MODEL=grok-build-0.1

# Database — SQLite by default; Postgres on the VPS (compose sets it).
DATABASE_URL=sqlite:///./data/crocbot.db
REDIS_URL=

# CLI engines (paths on the VPS; codex is at /opt/hatch-image/bin/codex here)
CODEX_BIN=codex
PI_BIN=pi
PI_SESSION_DIR=

# Budgets / limits
DAILY_USER_BUDGET_USD=5
CROCBOT_RATE_LIMIT_PER_MIN=60
CROCBOT_APPROVAL_TIMEOUT_S=900

# Fetch tool: default-deny. Add hostnames to allow fetching them.
CROCBOT_FETCH_ALLOWLIST=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CROCBOT_WORKDIR=.
CROCBOT_DATA_DIR=./data
CROCBOT_ALLOW_SHELL=false

# VPS only (compose): set on the server, never in git.
CROCBOT_DOMAIN=chat.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
