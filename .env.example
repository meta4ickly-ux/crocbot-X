# Crocbot X — copy to .env, never commit .env (chmod 600 on the server).
# Local dev: most of these can stay blank — the stub engine runs at $0.
CROCBOT_ENV=dev
CROCBOT_HOST=127.0.0.1
CROCBOT_PORT=8000
CROCBOT_LOG=crocbot-x.log

# Engine: muse (default, in-process), xai, codex, pi, stub, pocketpal
CROCBOT_ENGINE=muse
CROCBOT_ENGINE_TIMEOUT_S=300
CROCBOT_MAX_STEPS=10

# PocketPal — local model on a phone (Local API server, Plus, POC, no TLS).
# Live setup Nov 15, 2026: Razr "razorwudo" on Tailscale
# (motorazrjem@gmail.com tailnet) at http://100.121.19.70:8080/v1,
# Qwen2.5-3B-Instruct-Q4_K_M loaded, verified live over Wi-Fi and 5G.
# Join the same tailnet on the backend host — never expose the
# phone's port to the internet. No key by default; only set one if
# you set one in PocketPal. Never commit a real key.
POCKETPAL_BASE_URL=http://100.121.19.70:8080/v1
POCKETPAL_MODEL=Qwen2.5-3B-Instruct-Q4_K_M
POCKETPAL_API_KEY=

# xAI — the model provider. Never commit a real key.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_CHEAP_MODEL=grok-4.3
XAI_CODE_MODEL=grok-build-0.1

# Database — SQLite by default; Postgres on the VPS (compose sets it).
DATABASE_URL=sqlite:///./data/crocbot.db
REDIS_URL=

# CLI engines (paths on the VPS; codex is at /opt/hatch-image/bin/codex here)
CODEX_BIN=codex
PI_BIN=pi
PI_SESSION_DIR=

# Budgets / limits
DAILY_USER_BUDGET_USD=5
CROCBOT_RATE_LIMIT_PER_MIN=60
CROCBOT_APPROVAL_TIMEOUT_S=900

# Fetch tool: default-deny. Add hostnames to allow fetching them.
CROCBOT_FETCH_ALLOWLIST=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CROCBOT_WORKDIR=.
CROCBOT_DATA_DIR=./data
CROCBOT_ALLOW_SHELL=false

# VPS only (compose): set on the server, never in git.
# Auth — Caddy basic_auth for /ui/ + /api/. Username is plain,
# password hash is generated on the VPS:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Put the $2a$... output below. Never put a plaintext password here.
CROCBOT_USER=crocbot
CROCBOT_AUTH_HASH=
CROCBOT_DOMAIN=chat.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
